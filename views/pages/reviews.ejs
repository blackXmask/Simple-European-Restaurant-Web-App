<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<section class="reviews-page">
  <div class="container">
    <div class="section-title" style="margin-bottom: 40px;">
      <span class="subtitle">Guest Experiences</span>
      <h2>Reviews &amp; Testimonials</h2>
      <div class="divider"></div>
    </div>

    <div class="reviews-layout">
      <!-- Sidebar: Rating Summary -->
      <div class="reviews-sidebar">
        <div class="review-summary-card">
          <div class="big-rating"><%= avgRating || '—' %></div>
          <div class="stars">
            <% for (let i = 1; i <= 5; i++) { %>
              <i class="fa<%= avgRating && i <= Math.round(avgRating) ? 's' : 'r' %> fa-star"></i>
            <% } %>
          </div>
          <div class="count">Based on <%= reviewCount %> reviews</div>
        </div>

        <div class="review-summary-card" style="margin-top: 20px;">
          <h4 style="color: var(--burgundy); margin-bottom: 16px;">Rating Breakdown</h4>
          <% [5, 4, 3, 2, 1].forEach(function(star) {
            const entry = distribution.find(d => d.rating === star);
            const count = entry ? Number(entry.count) : 0;
            const pct = reviewCount > 0 ? (count / reviewCount * 100) : 0;
          %>
            <div class="rating-bar">
              <span class="star-label"><%= star %> ★</span>
              <div class="bar"><div class="bar-fill" style="width: <%= pct %>%;"></div></div>
              <span class="count"><%= count %></span>
            </div>
          <% }); %>
        </div>
      </div>

      <!-- Main: Reviews + Write Form -->
      <div>
        <% if (user) { %>
          <div class="write-review-section" id="write-review">
            <h3><i class="fas fa-pen-fancy"></i> Share Your Experience</h3>
            <form action="/reviews" method="POST">
              <div class="form-group">
                <label>Your Rating</label>
                <div class="star-rating">
                  <input type="radio" name="rating" id="star5" value="5" required>
                  <label for="star5"><i class="fas fa-star"></i></label>
                  <input type="radio" name="rating" id="star4" value="4">
                  <label for="star4"><i class="fas fa-star"></i></label>
                  <input type="radio" name="rating" id="star3" value="3">
                  <label for="star3"><i class="fas fa-star"></i></label>
                  <input type="radio" name="rating" id="star2" value="2">
                  <label for="star2"><i class="fas fa-star"></i></label>
                  <input type="radio" name="rating" id="star1" value="1">
                  <label for="star1"><i class="fas fa-star"></i></label>
                </div>
              </div>
              <div class="form-group">
                <label>Review Title (Optional)</label>
                <input type="text" name="title" class="form-control" placeholder="Summarise your experience in a few words">
              </div>
              <div class="form-group">
                <label>Your Review</label>
                <textarea name="comment" class="form-control" rows="4" placeholder="Tell us about your dining experience..." required></textarea>
              </div>
              <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-paper-plane"></i> Submit Review</button>
            </form>
          </div>
        <% } else { %>
          <div class="write-review-section" id="write-review" style="text-align: center;">
            <i class="fas fa-sign-in-alt" style="font-size: 2rem; color: var(--gold); margin-bottom: 12px;"></i>
            <h3>Share Your Experience</h3>
            <p style="color: var(--gray); margin-bottom: 16px;">Please sign in to write a review.</p>
            <a href="/auth/login" class="btn btn-primary"><i class="fas fa-sign-in-alt"></i> Sign In</a>
          </div>
        <% } %>

        <!-- Reviews List -->
        <div class="reviews-list">
          <% if (reviews.length === 0) { %>
            <div class="empty-state">
              <i class="fas fa-comment-dots"></i>
              <h3>No Reviews Yet</h3>
              <p>Be the first to share your dining experience!</p>
            </div>
          <% } else { %>
            <% reviews.forEach(function(review) { %>
              <div class="review-item-card">
                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 12px;">
                  <div class="review-author">
                    <% if (review.avatar_url) { %>
                      <img src="<%= review.avatar_url %>" alt="<%= review.user_name %>" class="avatar avatar-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'">
                      <div class="avatar" style="display:none;"><%= review.user_name.charAt(0) %></div>
                    <% } else { %>
                      <div class="avatar"><%= review.user_name.charAt(0) %></div>
                    <% } %>
                    <div>
                      <div class="name"><%= review.user_name %></div>
                      <div class="date"><%= new Date(review.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></div>
                    </div>
                  </div>
                  <div class="stars">
                    <% for (let i = 1; i <= 5; i++) { %>
                      <i class="fa<%= i <= review.rating ? 's' : 'r' %> fa-star"></i>
                    <% } %>
                  </div>
                </div>
                <% if (review.title) { %>
                  <h4 style="color: var(--burgundy); margin-bottom: 8px;"><%= review.title %></h4>
                <% } %>
                <p style="color: var(--gray); line-height: 1.7;"><%= review.comment %></p>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.star-rating { direction: rtl; justify-content: flex-start; }
.star-rating label { font-size: 2rem; }
</style>

<%- include('../partials/footer') %>
