<%- include('../../partials/admin-head') %>

<div class="admin-header">
  <h1>Order Management</h1>
</div>

<!-- Status Filter Tabs -->
<div class="admin-filters" style="margin-bottom: 24px;">
  <a href="/admin/orders" class="admin-filter-btn <%= activeStatus === 'all' ? 'active' : '' %>">All (<%= statusCounts.pending + statusCounts.preparing + statusCounts.ready + statusCounts.delivered + statusCounts.cancelled %>)</a>
  <a href="/admin/orders?status=pending" class="admin-filter-btn <%= activeStatus === 'pending' ? 'active' : '' %>">Pending (<%= statusCounts.pending %>)</a>
  <a href="/admin/orders?status=preparing" class="admin-filter-btn <%= activeStatus === 'preparing' ? 'active' : '' %>">Preparing (<%= statusCounts.preparing %>)</a>
  <a href="/admin/orders?status=ready" class="admin-filter-btn <%= activeStatus === 'ready' ? 'active' : '' %>">Ready (<%= statusCounts.ready %>)</a>
  <a href="/admin/orders?status=delivered" class="admin-filter-btn <%= activeStatus === 'delivered' ? 'active' : '' %>">Delivered (<%= statusCounts.delivered %>)</a>
  <a href="/admin/orders?status=cancelled" class="admin-filter-btn <%= activeStatus === 'cancelled' ? 'active' : '' %>">Cancelled (<%= statusCounts.cancelled %>)</a>
</div>

<div class="admin-table-card">
  <% if (orders.length === 0) { %>
    <div style="text-align: center; padding: 48px; color: var(--gray);">
      <i class="fas fa-receipt" style="font-size: 3rem; opacity: 0.3; margin-bottom: 12px;"></i>
      <p>No orders found.</p>
    </div>
  <% } else { %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Order #</th>
          <th>Customer</th>
          <th>Phone</th>
          <th>Items</th>
          <th>Total</th>
          <th>Status</th>
          <th>Date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(function(order) { %>
          <tr>
            <td><strong><%= order.order_number %></strong></td>
            <td>
              <strong><%= order.customer_name %></strong>
              <div style="font-size: 0.8rem; color: var(--gray);"><%= order.customer_email %></div>
            </td>
            <td><%= order.customer_phone %></td>
            <td><span style="color: var(--gray);"><%= order.delivery_type %></span></td>
            <td><strong>&euro;<%= order.total %></strong></td>
            <td>
              <form action="/admin/orders/<%= order.id %>/status?_method=PUT" method="POST" style="display: inline;">
                <select name="status" onchange="this.form.submit()" style="padding: 4px 8px; border-radius: 4px; border: 1px solid var(--gray-light); font-size: 0.8rem; cursor: pointer;">
                  <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pending</option>
                  <option value="preparing" <%= order.status === 'preparing' ? 'selected' : '' %>>Preparing</option>
                  <option value="ready" <%= order.status === 'ready' ? 'selected' : '' %>>Ready</option>
                  <option value="delivered" <%= order.status === 'delivered' ? 'selected' : '' %>>Delivered</option>
                  <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                </select>
              </form>
            </td>
            <td><%= new Date(order.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
            <td><a href="/admin/orders/<%= order.id %>" class="btn btn-outline btn-sm"><i class="fas fa-eye"></i></a></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../../partials/admin-footer') %>
