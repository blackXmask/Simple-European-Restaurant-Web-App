<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="auth-page">
  <div class="auth-card">
    <div class="logo-center">
      <i class="fas fa-utensils"></i>
      <h2>Welcome Back</h2>
      <p>Sign in to your account to place orders and write reviews</p>
    </div>

    <% if (errors && errors.length > 0) { %>
      <div class="form-error">
        <ul>
          <% errors.forEach(function(err) { %>
            <li><%= err %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <form action="/auth/login" method="POST">
      <div class="form-group">
        <label>Email Address</label>
        <input type="email" name="email" class="form-control" value="<%= old.email || '' %>" placeholder="you@example.com" required autofocus>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" class="form-control" placeholder="Enter your password" required>
      </div>
      <button type="submit" class="btn btn-primary btn-block btn-lg"><i class="fas fa-sign-in-alt"></i> Sign In</button>
    </form>

    <div class="form-footer">
      Don't have an account? <a href="/auth/signup">Create one now</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
