# Server Configuration
PORT=3000
NODE_ENV=development

# Session Secret (CHANGE THIS IN PRODUCTION)
SESSION_SECRET=la-maison-doree-secret-key-change-in-production

# Turso Database (get free at https://turso.tech — no credit card required)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Fallback: local SQLite file (for local dev only, no Turso needed)
# DB_PATH=file:local.db

# Admin Seeded Account
ADMIN_EMAIL=admin@lamaisondoree.com
ADMIN_PASSWORD=admin123

# Restaurant Info
RESTAURANT_NAME=La Maison Dorée
RESTAURANT_PHONE=+33 1 42 36 87 09
RESTAURANT_EMAIL=contact@lamaisondoree.com
RESTAURANT_ADDRESS=24 Rue du Faubourg Saint-Honoré, 75008 Paris, France
